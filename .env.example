# Binance Web3 API — https://web3.binance.com/en/dev-docs/authentication
# The Trading API signs every request with HMAC-SHA256. Both values stay server-side.
WEB3_API_KEY=
WEB3_API_SECRET=
WEB3_API_BASE=https://web3.binance.com/build

# BSC mainnet only.
NEXT_PUBLIC_CHAIN_ID=56
NEXT_PUBLIC_BSC_RPC=https://bsc-dataseed.binance.org

# Optional. Shows WalletConnect in the Connect menu. Create one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Caps enforced before any build / broadcast. USDT.
DEFAULT_ORDER_CAP_USDT=25
DEFAULT_DAILY_CAP_USDT=100

# Address used when a quote is requested before a wallet connects.
# RFQ routes require userWalletAddress. Replace with the connected wallet.
QUOTE_WALLET=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045

# Optional. Agent Studio identity (ERC-8004) and x402 resource the worker checks.
# Leave blank to show "unset" / "low". PARALLAX never invents a funded balance.
AGENT_ERC8004_ID=
AGENT_X402_URL=
AGENT_X402_MIN_USD=1
PARALLAX_DATA_DIR=
